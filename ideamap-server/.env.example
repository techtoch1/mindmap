# Copy these into cPanel > Setup Node.js App > Environment variables (or export them for local runs).
PORT=3000
# Keep the database OUTSIDE public_html, e.g. /home/CPANELUSER/ideamap-data
DATA_DIR=/home/CPANELUSER/ideamap-data
# 1 when the app sits behind Apache/nginx/Cloudflare (cPanel): trust X-Forwarded-* headers
TRUST_PROXY=1
# 1 when served over HTTPS: marks the session cookie Secure and enables HSTS
COOKIE_SECURE=1
# Optional: https://ideamap.aligned-tech.com  (extra allowed origin for WebSocket/API checks)
PUBLIC_URL=
# Optional: if set, first-run admin setup requires this secret (stops a stranger claiming the app first)
SETUP_TOKEN=
